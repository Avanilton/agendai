# ============================================
# Agendai — Variáveis de Ambiente (.env.local)
# Nunca commitar segredos reais no Git!
# Copie este arquivo para .env.local e preencha os valores reais.
# ============================================

# Neon PostgreSQL (provisionado via Vercel Marketplace ou Console Neon)
DATABASE_URL="postgresql://user:password@ep-example.sa-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Better Auth
# Gere um segredo forte com: openssl rand -base64 32
BETTER_AUTH_SECRET="substitua-por-um-segredo-aleatorio-de-no-minimo-32-caracteres"

# URL base da aplicação (em Preview na Vercel, deixe vazio para inferência automática)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# E-mail Transacional (Resend — opcional em dev; sem chave, links são exibidos no terminal)
RESEND_API_KEY=""
EMAIL_FROM="Agendai <onboarding@resend.dev>"

# Webhook Pix (opcional)
PIX_WEBHOOK_SECRET=""

# Ambiente
NODE_ENV="development"
